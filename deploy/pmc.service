[Unit]
Description=UniServ (prototipo PMC)
After=network.target

[Service]
Type=simple
WorkingDirectory=/var/www/pmc
Environment=PORT=3000
Environment=TZ=America/Bogota
Environment=DEMO=1
ExecStart=/usr/bin/node server/index.js
Restart=on-failure
User=www-data
Group=www-data

[Install]
WantedBy=multi-user.target
